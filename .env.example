# =============================================================================
# Chandigarh CivicAI — Environment Variables Template
# Phase 3: Supabase Database + Storage Foundation
# =============================================================================

# Application Settings
VITE_APP_NAME="Chandigarh CivicAI"
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
# -----------------------------------------------------------------------------
# Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon / Publishable Key (Public, safe for browser with RLS)
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# -----------------------------------------------------------------------------
# CRITICAL SECURITY WARNING:
# NEVER place your Supabase service_role key in any VITE_* variable.
# VITE_* variables are bundled into client-side code and visible to anyone.
# The service-role key bypasses Row Level Security and must only be used in
# protected server/edge functions.
# -----------------------------------------------------------------------------

# Supabase Storage Buckets
VITE_SUPABASE_EVIDENCE_BUCKET="complaint-evidence"
