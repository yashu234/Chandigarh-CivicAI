# =============================================================================
# Chandigarh CivicAI — Environment Variables Template
# Updated: Phase 13 — Deployment & Demo Readiness
# =============================================================================

# Application Settings
VITE_APP_NAME="Chandigarh CivicAI"
VITE_APP_ENV="development"         # development | staging | production
VITE_APP_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon / Publishable Key (Public, safe for browser with RLS enforced)
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# -----------------------------------------------------------------------------
# ⚠️ CRITICAL SECURITY WARNING
# -----------------------------------------------------------------------------
# NEVER place the following keys in any VITE_* variable:
#   - service_role key  → bypasses RLS, full DB access
#   - Gemini API key    → incurs billing on exposure
#   - JWT secret        → allows token forgery
#
# VITE_* variables are bundled into client-side JavaScript.
# Anyone can extract them from the browser Network tab.
#
# Edge Function secrets are configured via:
#   supabase secrets set GEMINI_API_KEY=<value>
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<value>
# -----------------------------------------------------------------------------

# Supabase Storage Bucket Names (safe public config values)
VITE_SUPABASE_EVIDENCE_BUCKET="complaint-evidence"

# -----------------------------------------------------------------------------
# Feature Flags (optional, for demo/staging overrides)
# -----------------------------------------------------------------------------
# VITE_ENABLE_DEMO_BANNER="true"   # Show "DEMO MODE" banner in UI
# VITE_AI_MOCK_MODE="false"        # true = use mock AI without Gemini key
